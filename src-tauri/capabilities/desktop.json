{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only features: updates and the gamer overlay window",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "windows": [
    "main",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-start-dragging",
    "core:window:allow-close"
  ]
}
